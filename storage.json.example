    "folder": "media",
    "healthCheckKey": "healthcheck.txt"
  },
  "VODSERVER": {
    "type": "s3",
    "accessKey": "YOUR_ACCESS_KEY",
    "accessSecret": "YOUR_SECRET_KEY",
    "region": "eu-central",
    "endpoint": "fsn1.your-objectstorage.com",
    "bucket": "your-vod-bucket",
    "folder": "ondemand",
    "healthCheckKey": "healthcheck.txt"
  }
}

